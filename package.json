{
  "name": "acme-supply-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 3000",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/next.mjs build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  }
}
